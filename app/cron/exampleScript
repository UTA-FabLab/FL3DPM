declare(strict_types = 1);

function cronProcess()
{
    print '  List of colleges' . PHP_EOL;
    \App\Request::cronInit();

    $colleges = new \App\Table\CollegesList();

    $colleges->query();

    while ($colleges->next()) {
        print '    ' . $colleges->college . PHP_EOL;
    }
}

